{
  "name": "@metreeca/tape",
  "version": "0.13.0",
  "description": "Simplified facade for the LogTape logging framework.",
  "keywords": [
    "typescript",
    "logging",
    "logtape"
  ],
  "homepage": "https://metreeca.github.io/tape/",
  "bugs": {
    "url": "https://github.com/metreeca/tape/issues",
    "email": "info@metreeca.com"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Metreeca",
    "email": "info@metreeca.com",
    "url": "https://www.metreeca.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metreeca/tape.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@metreeca/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "dist"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "clean": "ush rm dist docs node_modules",
    "prime": "npm ci",
    "setup": "npm ci && ush ln",
    "build": "ush rm dist docs && tsc -p tsconfig.build.json && npx typedoc",
    "check": "npx vitest --typecheck run",
    "proof": "npx typedoc && (npx typedoc --watch & npx wds --root-dir docs --watch --open)"
  },
  "dependencies": {
    "@logtape/logtape": "^2.3.2",
    "@metreeca/core": "^0.13.0"
  },
  "devDependencies": {
    "@metreeca/rack": "^0.6.0",
    "@web/dev-server": "^1.0.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "allowScripts": {
    "fsevents": false
  }
}
